<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="machineryBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A"/>
      <stop offset="50%" stop-color="#1E293B"/>
      <stop offset="100%" stop-color="#0B0F17"/>
    </linearGradient>
    <linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#94A3B8"/>
      <stop offset="50%" stop-color="#64748B"/>
      <stop offset="100%" stop-color="#334155"/>
    </linearGradient>
    <linearGradient id="amberAccent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#334155" stroke-width="0.5" stroke-opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#machineryBg)"/>
  <rect width="800" height="600" fill="url(#grid)"/>
  
  <!-- Industrial Graphic: Decommissioned Heavy Lathe & Gears -->
  <g transform="translate(100, 80)">
    <!-- Heavy Base -->
    <rect x="50" y="320" width="500" height="90" rx="8" fill="url(#metalGrad)" stroke="#475569" stroke-width="3"/>
    <rect x="70" y="300" width="460" height="25" rx="4" fill="#334155"/>
    
    <!-- Machinery Housing -->
    <rect x="90" y="160" width="180" height="140" rx="6" fill="#1E293B" stroke="#64748B" stroke-width="2"/>
    <circle cx="180" cy="230" r="45" fill="#0F172A" stroke="url(#amberAccent)" stroke-width="4"/>
    <circle cx="180" cy="230" r="20" fill="#64748B"/>
    
    <!-- Heavy Gear -->
    <g transform="translate(420, 210)">
      <circle cx="0" cy="0" r="80" fill="none" stroke="#64748B" stroke-width="16" stroke-dasharray="24 16"/>
      <circle cx="0" cy="0" r="50" fill="#1E293B" stroke="#94A3B8" stroke-width="4"/>
      <circle cx="0" cy="0" r="22" fill="#F59E0B"/>
    </g>

    <!-- Chuck & Spindle -->
    <rect x="270" y="215" width="80" height="30" fill="url(#metalGrad)"/>
    <rect x="350" y="195" width="25" height="70" rx="3" fill="#475569"/>
    
    <!-- Industrial Tag -->
    <rect x="50" y="430" width="500" height="40" rx="6" fill="#182230" stroke="#334155"/>
    <text x="70" y="456" fill="#F59E0B" font-family="system-ui, sans-serif" font-weight="bold" font-size="16" letter-spacing="1">PANWAR ENTERPRISES • INDUSTRIAL SCRAP VERIFIED</text>
  </g>
</svg>
