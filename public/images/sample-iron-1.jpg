<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="ironBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090D12"/>
      <stop offset="50%" stop-color="#161F28"/>
      <stop offset="100%" stop-color="#0D1117"/>
    </linearGradient>
    <linearGradient id="rustIron" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#78350F"/>
      <stop offset="50%" stop-color="#451A03"/>
      <stop offset="100%" stop-color="#292524"/>
    </linearGradient>
    <linearGradient id="castIron" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="50%" stop-color="#334155"/>
      <stop offset="100%" stop-color="#1E293B"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#ironBg)"/>
  
  <!-- Cast Iron Girders and Beams Stack -->
  <g transform="translate(120, 100)">
    <!-- Base I-Beams -->
    <path d="M 40 320 L 520 320 L 520 350 L 300 350 L 300 420 L 520 420 L 520 450 L 40 450 L 40 420 L 260 420 L 260 350 L 40 350 Z" fill="url(#castIron)" stroke="#64748B" stroke-width="2"/>
    <!-- Angled Heavy Plates -->
    <polygon points="80,180 340,140 400,280 140,320" fill="url(#rustIron)" opacity="0.9" stroke="#9A3412" stroke-width="2"/>
    <polygon points="220,130 480,90 540,230 280,270" fill="url(#castIron)" opacity="0.8" stroke="#475569" stroke-width="2"/>
    <!-- Heavy Solid Block -->
    <rect x="180" y="240" width="220" height="90" rx="4" fill="#1E293B" stroke="#F59E0B" stroke-width="2" stroke-dasharray="8 4"/>
    
    <text x="50" y="490" fill="#94A3B8" font-family="system-ui, sans-serif" font-size="15" letter-spacing="2">HEAVY MELTING CAST IRON DIES &amp; BEAMS • REWARI YARD</text>
  </g>
</svg>
