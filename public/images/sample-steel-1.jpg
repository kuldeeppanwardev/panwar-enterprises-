<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="steelBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B131E"/>
      <stop offset="100%" stop-color="#141E2B"/>
    </linearGradient>
    <linearGradient id="steelSheet" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#E2E8F0"/>
      <stop offset="30%" stop-color="#94A3B8"/>
      <stop offset="70%" stop-color="#CBD5E1"/>
      <stop offset="100%" stop-color="#64748B"/>
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#steelBg)"/>
  
  <!-- Stamped automobile sheet coils & skeletons -->
  <g transform="translate(140, 110)">
    <!-- Coil Ring -->
    <ellipse cx="260" cy="220" rx="200" ry="90" fill="none" stroke="url(#steelSheet)" stroke-width="35"/>
    <ellipse cx="260" cy="220" rx="140" ry="60" fill="none" stroke="#475569" stroke-width="15"/>
    
    <!-- Perforated Stamping Matrix -->
    <g fill="#0B131E" stroke="#94A3B8" stroke-width="1.5">
      <circle cx="160" cy="220" r="14"/>
      <circle cx="210" cy="210" r="14"/>
      <circle cx="260" cy="220" r="14"/>
      <circle cx="310" cy="210" r="14"/>
      <circle cx="360" cy="220" r="14"/>
    </g>
    
    <!-- Stack of sheets -->
    <polygon points="100,340 420,340 380,410 60,410" fill="url(#steelSheet)" opacity="0.85"/>
    <polygon points="110,330 430,330 390,400 70,400" fill="#64748B" opacity="0.6"/>
    
    <text x="60" y="470" fill="#38BDF8" font-family="system-ui, sans-serif" font-weight="600" font-size="16" letter-spacing="1.5">AUTOMOBILE SHEET METAL &amp; CRC COIL SKELETONS</text>
  </g>
</svg>
